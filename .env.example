# Required: Discord bot credentials
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# HTTP server configuration
BOT_BIND_ADDR=0.0.0.0:3010
BOT_BIND_PORT=3010

# Shared secret for authenticating inbound HTTP requests from Osmium
BOT_API_SHARED_KEY=

# Osmium API connection
OSMIUM_BASE_URL=http://127.0.0.1:3000
OSMIUM_BEARER_TOKEN=

# Comma-separated Discord guild IDs where slash commands are registered
BOT_COMMAND_GUILD_IDS=

# Comma-separated Discord role/user IDs allowed to use operator commands
# If both are empty, operator commands are allowed for all users (dev mode)
BOT_OPERATOR_ROLE_IDS=
BOT_OPERATOR_USER_IDS=

# Audit logging configuration
AUDIT_LOGGING_ENABLED=true
AUDIT_INCLUDE_BOT_EVENTS=false
AUDIT_FETCH_AUDIT_LOGS=true
AUDIT_MAX_FIELD_CHARS=900

# How often (seconds) to re-pull the Discord config bundle from osmium so channel
# and role changes made in the website apply without restarting the bot. Default 60.
CONFIG_SYNC_INTERVAL_SECS=60

# Public base URL (reachable by Discord's servers) that serves osmium event
# banners at /cdn/{asset_id}; used as the event-posting embed image. Leave unset
# in local dev — Discord cannot fetch localhost, so the banner is omitted there.
# In production set this to osmium's public origin, e.g. https://api.vzdc.org
EVENT_BANNER_BASE_URL=

# Public website base URL used to link an event posting back to its signup page
# at /events/{id} (shown at the top of the embed). e.g. https://vzdc.org
EVENT_SIGNUP_BASE_URL=

# Staffup worker configuration
STAFFUP_ENABLED=true
STAFFUP_POLL_INTERVAL_SECS=10
STAFFUP_BATCH_SIZE=100
STAFFUP_CURSOR_PATH=data/staffup_cursor.json
STAFFUP_ENVIRONMENT=live
STAFFUP_ARTCC_ID=ZDC

# Interactive message state paths
IMPROMPTU_SELECTOR_STATE_PATH=data/impromptu_selector_message.json
BREAK_BOARD_STATE_PATH=data/break_board_messages.json
BREAK_BOARD_REQUESTS_PATH=data/break_board_requests.json
# Tracks the last event-posting message per event so a re-post deletes the old one.
EVENT_POSTING_STATE_PATH=data/event_postings.json
# Tracks native Discord scheduled events created per event so re-running replaces
# the old one. The scheduled-event cover image reuses EVENT_BANNER_BASE_URL.
SCHEDULED_EVENT_STATE_PATH=data/scheduled_events.json

# Logging configuration
RUST_LOG=info
