# Staging environment configuration
# Copy to .env and fill in secrets before deployment

# Required: Discord bot credentials (use a separate staging bot)
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# HTTP server configuration
BOT_BIND_ADDR=0.0.0.0:3010
BOT_BIND_PORT=3010

# Shared secret for authenticating inbound HTTP requests from Osmium
BOT_API_SHARED_KEY=

# Osmium API connection (staging Osmium instance)
OSMIUM_BASE_URL=https://staging.osmium.vzdc.org
OSMIUM_BEARER_TOKEN=

# Discord guild IDs where slash commands are registered (staging guild only)
BOT_COMMAND_GUILD_IDS=

# Discord role/user IDs allowed to use operator commands
BOT_OPERATOR_ROLE_IDS=
BOT_OPERATOR_USER_IDS=

# Audit logging (enabled for testing)
AUDIT_LOGGING_ENABLED=true
AUDIT_INCLUDE_BOT_EVENTS=true
AUDIT_FETCH_AUDIT_LOGS=true
AUDIT_MAX_FIELD_CHARS=900

# Staffup worker (use sweatbox environment for staging)
STAFFUP_ENABLED=true
STAFFUP_POLL_INTERVAL_SECS=10
STAFFUP_BATCH_SIZE=100
STAFFUP_CURSOR_PATH=data/staffup_cursor.json
STAFFUP_ENVIRONMENT=sweatbox
STAFFUP_ARTCC_ID=ZDC

# Interactive message state paths
IMPROMPTU_SELECTOR_STATE_PATH=data/impromptu_selector_message.json
BREAK_BOARD_STATE_PATH=data/break_board_messages.json
BREAK_BOARD_REQUESTS_PATH=data/break_board_requests.json

# Logging (debug level for staging)
RUST_LOG=debug
